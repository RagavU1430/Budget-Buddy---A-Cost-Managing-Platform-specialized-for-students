# ---------------------------------------------------------------------------
# BudgetBuddy FastAPI — environment template. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# Core
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
APP_NAME=budgetbuddy-api

# Database (Supabase PostgreSQL is mandatory)
# Format: postgresql+asyncpg://postgres:password@host:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your-password@your-project.supabase.co:5432/postgres

# JWT lifetimes (DRF SimpleJWT parity: 60 minutes / 7 days)
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# CORS (comma separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://budgetbuddy-student.vercel.app,https://frontend-iota-black-70.vercel.app,https://budgetbuddy-app-six.vercel.app,https://budgetbuddy-app.vercel.app,https://*.up.railway.app

# AI assistant (optional — the deterministic fallback works without it)
GEMINI_API_KEY=
GEMINI_MODELS=models/gemini-2.5-flash,models/gemini-2.0-flash

# Email verification (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Storage: "local" | "supabase"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./media

# Production storage (uncomment for cloud storage)
# STORAGE_BACKEND=supabase
# LOCAL_STORAGE_DIR=/app/media

# Supabase Storage (S3 compatible) — only used when STORAGE_BACKEND=supabase
SUPABASE_S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=reports
# Signed download URL lifetime (seconds)
SUPABASE_SIGNED_URL_TTL=300
