{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDirectory": "dist",
        "env": {
          "VITE_API_URL": ":apiUrl"
        }
      }
    }
  ],
  "routes": [
    {
      "handle": "f",
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "cleanOutputs": true
}