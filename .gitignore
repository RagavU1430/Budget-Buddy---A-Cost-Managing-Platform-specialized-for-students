.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Django / SQLite
*.sqlite3
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Node.js / Vite / React
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Secrets (Keep .env.example tracked)
.env
.env.*
!.env.example
*.pem
*.key

# IDE / Operating System
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
